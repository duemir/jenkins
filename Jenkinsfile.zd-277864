@Library('example') _
pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven:3-eclipse-temurin-21
    command:
    - sleep
    args:
    - infinity
    securityContext:
      runAsUser: 1000
'''
            retries 2
        }
    }
    stages {
        stage('Main') {
            steps {
                sh 'hostname'
                helloWorld()
                container('maven') {
                  sh 'mvn -am -pl war,bom -Pquick-build clean install'
                }
            }
        }
    }
}

